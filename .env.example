# ==========================================================
# OPTION 1: (Easiest - 1 Min Setup, No GCP Console Needed)
# Deploy a simple Google Apps Script Web App on your Google Sheet
# and paste its URL below:
GOOGLE_SHEET_WEBHOOK_URL=
# ==========================================================

# ==========================================================
# OPTION 2: Google Cloud Service Account
# Save your downloaded JSON key as credentials.json
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
SPREADSHEET_NAME=Event Bookings
SPREADSHEET_ID=
# ==========================================================

PORT=8000
